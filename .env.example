# Copy this file to `.env` for local development — there are no defaults in
# code, so these are required for the app to run. In CI, the deploy workflow
# sets all of these; see .github/workflows/deploy.yml.

# GitHub organization/user this site showcases (public — used in links/UI).
NUXT_PUBLIC_ORG_USERNAME=telefunction

# Canonical deployed URL of this site (no trailing slash, public).
NUXT_PUBLIC_SITE_URL=https://telefunction.github.io

# GitHub token used at build time to fetch org/repo data via GraphQL + REST
# (server-only — never sent to the browser). A token with no special scopes
# works fine for public org/repo data, e.g. `gh auth token`.
NUXT_GITHUB_TOKEN=

# Comma-separated repo names to feature on the homepage, overriding GitHub's
# real pinned repositories. Leave empty to use the org's actual pinned repos
# (or, if none are pinned, every public repo sorted by stars).
NUXT_PINNED_REPOS=
